# ------------------------------------------------------------------
# Career Intelligence Platform - Environment Configuration
# Copy to .env and adjust values. NEVER commit the real .env file.
# ------------------------------------------------------------------

# ---- App ----
ENVIRONMENT=development
APP_NAME=Career Intelligence Platform
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ---- Database (PostgreSQL) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=career
POSTGRES_PASSWORD=career
POSTGRES_DB=career_intelligence
DATABASE_URL=postgresql+psycopg://career:career@localhost:5432/career_intelligence

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- Celery ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_MODEL_REGISTRY_NAME=salary-predictor
MLFLOW_EXPERIMENT_NAME=salary-prediction

# ---- Storage ----
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- NLP ----
SPACY_MODEL=en_core_web_lg
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
